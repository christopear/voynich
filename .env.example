# Copy to .env; do not commit credentials. Load with: uv run --env-file .env ...
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=voynich
PGUSER=voynich
# Set locally, or use a PostgreSQL password file. Quote special characters as needed.
PGPASSWORD=
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=5
# Optional CA certificate path when using verify-ca or verify-full:
# PGSSLROOTCERT=/absolute/path/root.crt
